#!/usr/bin/env bash
# Forgejo's own secrets as files (app.ini names them with *_URI): taken over
# from an app.ini that still holds them inline, else generated. Existing
# files are kept. Prints the files it wrote.
set -euo pipefail
INI=/etc/forgejo/app.ini
inline() {   # section key: the value of key in [section] of app.ini
    [[ -f $INI ]] || return 0
    awk -v s="[$1]" -v k="$2" '
        /^\[/ { in_s = ($0 == s) }
        in_s && $0 ~ "^[[:space:]]*" k "[[:space:]]*=" { sub(/^[^=]*=[[:space:]]*/, ""); print; exit }' "$INI"
}
for spec in "security SECRET_KEY secret_key" "security INTERNAL_TOKEN internal_token" "oauth2 JWT_SECRET jwt_secret"; do
    read -r section key file <<<"$spec"
    f=/etc/forgejo/$file
    [[ -s $f ]] && continue
    value=$(inline "$section" "$key")
    [[ -n $value ]] || value=$(/usr/local/bin/forgejo generate secret "$key")
    (umask 027; printf '%s\n' "$value" > "$f")
    chown root:git "$f"
    echo "$f"
done
