[Unit]
Description=Forgejo
After=network-online.target
Wants=network-online.target
[Service]
User=git
Group=git
WorkingDirectory={{ forgejo_work_dir }}
ExecStart=/usr/local/bin/forgejo web --config /etc/forgejo/app.ini
Restart=always
Environment=USER=git HOME={{ forgejo_work_dir }} FORGEJO_WORK_DIR={{ forgejo_work_dir }}
[Install]
WantedBy=multi-user.target
