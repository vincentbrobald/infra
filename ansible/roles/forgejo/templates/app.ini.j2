APP_NAME = {{ forgejo_app_name }}
RUN_USER = git
RUN_MODE = prod
WORK_PATH = {{ forgejo_work_dir }}
[server]
HTTP_ADDR = 127.0.0.1
DOMAIN = {{ forgejo_hostname }}
HTTP_PORT = {{ forgejo_http_port }}
ROOT_URL = https://{{ forgejo_hostname }}/
START_SSH_SERVER = true
SSH_DOMAIN = {{ forgejo_hostname }}
SSH_PORT = {{ forgejo_ssh_port }}
SSH_LISTEN_PORT = {{ forgejo_ssh_port }}
[database]
DB_TYPE = sqlite3
PATH = {{ forgejo_work_dir }}/data/forgejo.db
[security]
INSTALL_LOCK = true
SECRET_KEY_URI = file:/etc/forgejo/secret_key
INTERNAL_TOKEN_URI = file:/etc/forgejo/internal_token
[oauth2]
JWT_SECRET_URI = file:/etc/forgejo/jwt_secret
[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true
[repository]
DEFAULT_PRIVATE = private
ENABLE_PUSH_CREATE_USER = true
[log]
LEVEL = Info

[oauth2_client]
ENABLE_AUTO_REGISTRATION = true
USERNAME = preferred_username
{% if forgejo_webhook_allowed_hosts %}

[webhook]
ALLOWED_HOST_LIST = {{ forgejo_webhook_allowed_hosts | join(',') }}
{% endif %}
