# {{ ansible_managed }} (role harbor)
[Unit]
Description=Harbor container registry (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ harbor_dir }}
ExecStart=/usr/bin/docker compose -f {{ harbor_dir }}/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f {{ harbor_dir }}/docker-compose.yml down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
